#!/usr/bin/env bash
# Refuse a push whose branch's newest PR is MERGED and whose pushed commit does not contain that
# merge: the commits would sit on a branch no PR tracks. A merged PR on the branch is not itself
# the signal (one branch may legitimately carry successive PRs); only the missing merge is.
# Fails open without gh/jq or on gh/network errors. Deliberate bypass: git push --no-verify.
set -uo pipefail

remote=$1
command -v gh >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

while read -r local_ref local_oid _remote_ref _remote_oid; do
  case "$local_ref" in refs/heads/*) branch=${local_ref#refs/heads/} ;; *) continue ;; esac
  [ "$local_oid" != "0000000000000000000000000000000000000000" ] || continue

  json=$(timeout 10 gh pr list --head "$branch" --state all --limit 1 \
           --json number,state,mergedAt,mergeCommit,baseRefName 2>/dev/null) || continue
  [ "$(printf '%s' "$json" | jq -r '.[0].state // empty' 2>/dev/null)" = "MERGED" ] || continue
  oid=$(printf '%s' "$json" | jq -r '.[0].mergeCommit.oid // empty' 2>/dev/null)
  [ -n "$oid" ] || continue
  base=$(printf '%s' "$json" | jq -r '.[0].baseRefName // empty' 2>/dev/null)

  [ "${DEAD_BRANCH_GUARD_NO_FETCH:-}" = "1" ] || [ -z "$base" ] || git fetch -q "$remote" "$base" 2>/dev/null
  git merge-base --is-ancestor "$oid" "$local_oid" 2>/dev/null && continue

  num=$(printf '%s' "$json" | jq -r '.[0].number')
  at=$(printf '%s' "$json" | jq -r '.[0].mergedAt')
  cat >&2 <<EOF
pre-push: PR #$num for branch '$branch' was MERGED at $at and the commit you are pushing does not
contain that merge. It would sit on a dead branch that no PR tracks.
Either continue the branch:  git fetch $remote && git merge $remote/$base   (then push and gh pr create)
or rehome the new commits:   git checkout -b <new-branch> $remote/$base && git cherry-pick <first-new-sha>^..HEAD
Bypass only on purpose: git push --no-verify
EOF
  exit 1
done

exit 0
