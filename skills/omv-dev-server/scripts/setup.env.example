# Copy to setup.env and fill in. setup.env is gitignored — it is the only file that
# holds real values for your machine. Everything else in this skill uses placeholders.

# The dev user. Create it through the OMV web UI first (see HOST.md for why), then the
# scripts verify and repair it.
DEV_USER=dev

# The data disk mount point. Find it with: df -hT | grep /srv
# Use the data disk, not the OS disk.
DATA_DISK=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000

# Derived by default; override only if you want a different layout.
#DEV_ROOT=$DATA_DISK/dev
#REPO_ROOT=$DEV_ROOT/repos
#DEV_HOME_DIR=$DEV_ROOT/dev-home

# Dev container image tag.
IMAGE=dev-ai

# Public SSH key to install for DEV_USER (the whole one-line "ssh-ed25519 AAAA... comment").
# Leave empty to skip.
SSH_PUBKEY=

# Local port that `tailscale serve` should front over HTTPS. 2283 is Immich.
SERVE_PORT=2283
