#!/usr/bin/env bash
#
# dev — launch or attach to a per-repository dev container.
#
#   dev                 from anywhere under $DEV_REPO_ROOT
#   dev --recreate      discard the container and start a fresh one (picks up a rebuilt image)
#   dev --name X        override the container name
#
# Two decisions drive the whole design, and the obvious version of each is wrong:
#
#   1. The repo ROOT is mounted at a fixed /workspace and the container's working directory
#      keeps the repo's sub-path. Agent tooling keys per-project memory off the absolute
#      working directory, so mounting each repo at /workspace in turn gives every repo the
#      same key and merges all their memories into one pile.
#
#   2. Nothing is bind-mounted as a single FILE. Docker binds a file by inode; a process
#      that saves by temp-file-and-rename therefore writes to an inode the host never sees,
#      or fails with "Device or resource busy". The whole HOME is one host directory.
#
set -euo pipefail

IMAGE="${DEV_IMAGE:-dev-ai}"
REPO_ROOT="${DEV_REPO_ROOT:-$HOME/repos}"
DEV_HOME="${DEV_HOME_DIR:-$HOME/.dev-home}"

MEMORY="${DEV_MEMORY:-8g}"          # size to the box; a NAS runs services people rely on
PIDS="${DEV_PIDS:-512}"             # an agent runs a daemon plus pty hosts; 100 is too low
SHM="${DEV_SHM:-1g}"                # headless Chrome dies on Docker's 64m default
PORT_SPEC="${DEV_PORT:-0}:5000"     # 0 = random host port, so it cannot collide
MOUNT_DOCKER_SOCK="${DEV_DOCKER_SOCK:-0}"

RECREATE=0; NAME_OVERRIDE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --recreate) RECREATE=1 ;;
    --name) NAME_OVERRIDE="${2:?--name needs a value}"; shift ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) NAME_OVERRIDE="$1" ;;
  esac
  shift
done

# --- where are we, relative to the repo root? -------------------------------------------
[ -d "$REPO_ROOT" ] || { echo "DEV_REPO_ROOT does not exist: $REPO_ROOT" >&2; exit 1; }
REPO_ROOT="$(cd "$REPO_ROOT" && pwd -P)"
here="$(pwd -P)"
case "$here/" in
  "$REPO_ROOT"/*) rel="${here#"$REPO_ROOT"}" ;;   # empty when here == REPO_ROOT
  *) echo "✋ $here is outside DEV_REPO_ROOT ($REPO_ROOT)." >&2
     echo "   cd into a repo under it, or set DEV_REPO_ROOT." >&2; exit 1 ;;
esac
WORKDIR="/workspace${rel}"

# Name from the FULL relative path, not the leaf: two repos sharing a basename would
# otherwise collide on one container, and attaching lands in the wrong /workspace.
slug="$(printf '%s' "${rel:-/workspace}" | sed 's|^/||; s|/|_|g')"
NAME="dev_$(printf '%s' "${NAME_OVERRIDE:-${slug:-workspace}}" | tr -c 'a-zA-Z0-9_.-' '_')"

# --- the container's HOME ----------------------------------------------------------------
mkdir -p "$DEV_HOME/.ssh" "$DEV_HOME/.config/gh" "$DEV_HOME/.claude"
chmod 700 "$DEV_HOME" "$DEV_HOME/.ssh"
find "$DEV_HOME/.ssh" -type f -exec chmod 600 {} + 2>/dev/null || true
[ -f "$DEV_HOME/.gitconfig" ] || cp "$HOME/.gitconfig" "$DEV_HOME/.gitconfig" 2>/dev/null || touch "$DEV_HOME/.gitconfig"

exists()  { docker ps -a --format '{{.Names}}' | grep -qx "$NAME"; }
running() { docker ps    --format '{{.Names}}' | grep -qx "$NAME"; }

if [ "$RECREATE" = 1 ] && exists; then
  echo "♻️  removing '${NAME}'..."
  docker rm -f "$NAME" >/dev/null
fi

# --- attach to what is already there -----------------------------------------------------
if running || { exists && [ "$RECREATE" = 0 ]; }; then
  running || { echo "▶️  starting '${NAME}'..."; docker start "$NAME" >/dev/null; }
  # A container with the right name can still have been created with a different mount
  # layout (an older launcher, another repo root). Exec'ing blindly fails with a raw OCI
  # "chdir to cwd ... no such file or directory", which says nothing about the real cause.
  if ! docker exec "$NAME" test -d "$WORKDIR" 2>/dev/null; then
    echo "✋ '${NAME}' exists but ${WORKDIR} is not inside it. Its mounts:" >&2
    docker inspect "$NAME" --format '{{range .Mounts}}   {{.Source}} -> {{.Destination}}
{{end}}' >&2
    echo "   Recreate it with:  dev --recreate" >&2
    exit 1
  fi
  echo "🔗 attaching to '${NAME}' at ${WORKDIR}"
  # --user on exec too: it defaults to the IMAGE's user, not the running container's, so
  # without this an exec into a --user container still lands as root and writes root files.
  exec docker exec -it --user "$(id -u):$(id -g)" -w "$WORKDIR" "$NAME" bash
fi

# --- create ------------------------------------------------------------------------------
args=(
  --name "$NAME"
  --init                                  # reap zombies; node and git leave them
  --user "$(id -u):$(id -g)"              # files in /workspace stay host-owned
  -e HOME=/dev-home
  -e REPO_ROOT=/workspace
  -e GIT_TERMINAL_PROMPT=0
  -v "$REPO_ROOT:/workspace"
  -v "$DEV_HOME:/dev-home"
  -w "$WORKDIR"
  -p "$PORT_SPEC"
  --memory "$MEMORY"
  --pids-limit "$PIDS"
  --shm-size "$SHM"
  --security-opt no-new-privileges
)

# Only when non-empty: an empty GH_TOKEN is worse than absent, because gh treats it as a
# configured-but-broken credential instead of falling back to a stored login. Never baked
# into a layer — a token in an image layer survives being deleted from it.
if [ -n "${GH_TOKEN:-}" ]; then args+=( -e "GH_TOKEN=${GH_TOKEN}" ); fi

if [ "$MOUNT_DOCKER_SOCK" = 1 ]; then
  echo "⚠️  mounting docker.sock — anything in this container has root on the host."
  args+=( -v /var/run/docker.sock:/var/run/docker.sock )
fi

echo "🚀 launching '${NAME}' at ${WORKDIR}"
echo "   host port: docker port ${NAME} 5000"
# Deliberately NOT --rm: it looks tidy and sets a trap, because typing `exit` would delete
# a container that may be hosting a live agent session, with no way to start it again.
exec docker run -it "${args[@]}" "$IMAGE" bash
