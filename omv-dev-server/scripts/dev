#!/usr/bin/env bash
#
# dev — launch or attach to a per-repository dev container.
#
#   dev                 from anywhere under $DEV_REPO_ROOT
#   dev --recreate      discard the container and start a fresh one (picks up a rebuilt image)
#   dev --name X        override the container name
#
# Two decisions drive the whole design, and the obvious version of each is wrong:
#
#   1. The repo ROOT is mounted at a fixed /workspace and the container's working directory
#      keeps the repo's sub-path. Agent tooling keys per-project memory off the absolute
#      working directory, so mounting each repo at /workspace in turn gives every repo the
#      same key and merges all their memories into one pile.
#
#   2. Nothing is bind-mounted as a single FILE. Docker binds a file by inode; a process
#      that saves by temp-file-and-rename therefore writes to an inode the host never sees,
#      or fails with "Device or resource busy". The whole HOME is one host directory.
#
set -euo pipefail

IMAGE="${DEV_IMAGE:-dev-ai}"
REPO_ROOT="${DEV_REPO_ROOT:-$HOME/repos}"
DEV_HOME="${DEV_HOME_DIR:-$HOME/.dev-home}"

MEMORY="${DEV_MEMORY:-8g}"          # size to the box; a NAS runs services people rely on
PIDS="${DEV_PIDS:-512}"             # an agent runs a daemon plus pty hosts; 100 is too low
SHM="${DEV_SHM:-1g}"                # headless Chrome dies on Docker's 64m default
PORT_SPEC="${DEV_PORT:-0}:5000"     # 0 = random host port, so it cannot collide
MOUNT_DOCKER_SOCK="${DEV_DOCKER_SOCK:-0}"

RECREATE=0; NAME_OVERRIDE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --recreate) RECREATE=1 ;;
    --name) NAME_OVERRIDE="${2:?--name needs a value}"; shift ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) NAME_OVERRIDE="$1" ;;
  esac
  shift
done

# --- where are we, relative to the repo root? -------------------------------------------
[ -d "$REPO_ROOT" ] || { echo "DEV_REPO_ROOT does not exist: $REPO_ROOT" >&2; exit 1; }
REPO_ROOT="$(cd "$REPO_ROOT" && pwd -P)"
here="$(pwd -P)"
case "$here/" in
  "$REPO_ROOT"/*) rel="${here#"$REPO_ROOT"}" ;;   # empty when here == REPO_ROOT
  *) echo "✋ $here is outside DEV_REPO_ROOT ($REPO_ROOT)." >&2
     echo "   cd into a repo under it, or set DEV_REPO_ROOT." >&2; exit 1 ;;
esac
WORKDIR="/workspace${rel}"

# Name from the FULL relative path, not the leaf: two repos sharing a basename would
# otherwise collide on one container, and attaching lands in the wrong /workspace.
slug="$(printf '%s' "${rel:-/workspace}" | sed 's|^/||; s|/|_|g')"
container_name() { printf 'dev_%s' "$(printf '%s' "$1" | tr -c 'a-zA-Z0-9_.-' '_')"; }
NAME="$(container_name "${NAME_OVERRIDE:-${slug:-workspace}}")"

# --- the container's HOME ----------------------------------------------------------------
# projects/ and skills/ exist up front so they are linked, not created per container by Claude.
mkdir -p "$DEV_HOME/.ssh" "$DEV_HOME/.config/gh" "$DEV_HOME/.claude/projects" "$DEV_HOME/.claude/skills"
chmod 700 "$DEV_HOME" "$DEV_HOME/.ssh"
find "$DEV_HOME/.ssh" -type f -exec chmod 600 {} + 2>/dev/null || true
[ -f "$DEV_HOME/.gitconfig" ] || cp "$HOME/.gitconfig" "$DEV_HOME/.gitconfig" 2>/dev/null || touch "$DEV_HOME/.gitconfig"

# --- somewhere writable for tools that update themselves ---------------------------------
# Everything baked into the image is installed as root under /usr, and this container runs
# as an arbitrary uid, so a tool that tries to update itself in place fails — npm says
# "no write permission to npm prefix", naming the prefix rather than the reason. Point npm
# at the one directory that is both writable and persistent: this home. An update then
# survives `--recreate` and a reboot, where chowning a path inside the image would not.
#
# All three are seeded only when absent, so edits of your own are never overwritten.
if [ ! -f "$DEV_HOME/.npmrc" ]; then
  # ${HOME} rather than a literal: npm expands it, and the container home is set at runtime.
  printf 'prefix=${HOME}/.npm-global\n' > "$DEV_HOME/.npmrc"
fi
if [ ! -f "$DEV_HOME/.bashrc" ]; then
  cat > "$DEV_HOME/.bashrc" <<'RC'
# Prepended, so a self-updated tool here shadows the image's root-owned copy.
# Delete ~/.npm-global to fall back to the version pinned in the image.
export PATH="$HOME/.npm-global/bin:$PATH"
RC
fi
if [ ! -f "$DEV_HOME/.profile" ]; then
  # A login shell reads .profile; an interactive one reads .bashrc. The launcher produces
  # both shapes, so defer the way Debian's skel does instead of duplicating the PATH line.
  cat > "$DEV_HOME/.profile" <<'RC'
[ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
RC
fi

# --- a passwd entry for an arbitrary UID -------------------------------------------------
# `--user 1001:100` hands the container a uid the image has never heard of, and the failure
# is not cosmetic. Anything calling getpwuid() fails hard instead of degrading: ssh exits
# with "No user exists for uid 1001" *before* it reads your key, so git-over-SSH is dead and
# the message names neither the container nor the cause. The only visible hint is the shell
# prompt reading "I have no name!", which looks like a cosmetic annoyance and is not.
#
# Generate a passwd file — the image's own, plus one line for you — and mount it read-only.
# Read-only is what keeps this clear of the never-bind-mount-a-single-file rule: that rule
# exists because *writes* land on an inode the host never sees, and nothing writes here.
# The entry's home is /dev-home because ssh takes the home directory from the passwd entry
# rather than from $HOME, and /dev-home/.ssh is where the keys are.
#
# Regenerated only when the line is missing, so it costs one `docker run` once. If you
# rebuild the image with new accounts in it, delete this file to pick them up.
PASSWD_FILE="$DEV_HOME/.container-passwd"
passwd_line="$(id -un):x:$(id -u):$(id -g):dev container user:/dev-home:/bin/bash"
if ! grep -qxF "$passwd_line" "$PASSWD_FILE" 2>/dev/null; then
  { docker run --rm "$IMAGE" cat /etc/passwd && echo "$passwd_line"; } > "$PASSWD_FILE" \
    || rm -f "$PASSWD_FILE"
fi

exists()  { docker ps -a --format '{{.Names}}' | grep -qx "$NAME"; }
running() { docker ps    --format '{{.Names}}' | grep -qx "$NAME"; }
# A container keeps the image it was created from; a rebuild only moves the tag.
created_from_older_image() {
  local tagged_image container_image
  # A missing image is left for docker run, whose error names it.
  tagged_image="$(docker image inspect "$IMAGE" --format '{{.Id}}' 2>/dev/null)" || return 1
  container_image="$(docker container inspect "$NAME" --format '{{.Image}}')" || return 1
  [ "$tagged_image" != "$container_image" ]
}

if [ "$RECREATE" = 1 ] && exists; then
  echo "♻️  removing '${NAME}'..."
  docker rm -f "$NAME" >/dev/null
fi

# --- a container built from an image that has since been rebuilt ------------------------
# Stopped: only changes made inside the container, outside the mounted repos and home, are lost.
if [ "$RECREATE" = 0 ] && exists && created_from_older_image; then
  if running; then
    echo "⚠️  '${NAME}' runs an image older than '${IMAGE}'. Left alone in case a session is" >&2
    echo "   inside. Pick up the rebuild with:  dev --recreate" >&2
  else
    echo "♻️  '${NAME}' is stopped and on an old image; recreating it."
    docker rm "$NAME" >/dev/null
  fi
fi

# --- attach to what is already there -----------------------------------------------------
if running || { exists && [ "$RECREATE" = 0 ]; }; then
  running || { echo "▶️  starting '${NAME}'..."; docker start "$NAME" >/dev/null; }
  # A container with the right name can still have been created with a different mount
  # layout (an older launcher, another repo root). Exec'ing blindly fails with a raw OCI
  # "chdir to cwd ... no such file or directory", which says nothing about the real cause.
  if ! docker exec "$NAME" test -d "$WORKDIR" 2>/dev/null; then
    echo "✋ '${NAME}' exists but ${WORKDIR} is not inside it. Its mounts:" >&2
    docker inspect "$NAME" --format '{{range .Mounts}}   {{.Source}} -> {{.Destination}}
{{end}}' >&2
    echo "   Recreate it with:  dev --recreate" >&2
    exit 1
  fi
  echo "🔗 attaching to '${NAME}' at ${WORKDIR}"
  # --user on exec too: it defaults to the IMAGE's user, not the running container's, so
  # without this an exec into a --user container still lands as root and writes root files.
  exec docker exec -it --user "$(id -u):$(id -g)" -w "$WORKDIR" "$NAME" bash
fi

# --- a Claude Code config folder per container -------------------------------------------
# Every container runs its own Claude daemon in its own PID namespace. Sharing one config
# folder means sharing one daemon.lock and one job list, so when an auto-update restarts
# every daemon at once, the winner cannot see the other containers' sessions and marks them
# failed. Each container gets its own folder, linked back to what is user-wide.
#
# Seeded on create only: a container keeps the folder it was created with until it is
# recreated, and each item is seeded only when absent.
CLAUDE_SHARED="$DEV_HOME/.claude"
CLAUDE_OWN="$DEV_HOME/.claude-containers/$NAME"
mkdir -p "$CLAUDE_OWN"
for item in CLAUDE.md settings.json settings.local.json skills projects; do
  # Relative, so the link resolves both on the host and under /dev-home in the container.
  # -L as well as -e: a dangling link still occupies the name, and a shared item may be a
  # link that resolves only inside the container.
  if { [ -e "$CLAUDE_SHARED/$item" ] || [ -L "$CLAUDE_SHARED/$item" ]; } \
     && [ ! -e "$CLAUDE_OWN/$item" ] && [ ! -L "$CLAUDE_OWN/$item" ]; then
    ln -s "../../.claude/$item" "$CLAUDE_OWN/$item"
  fi
done
# Copied, not linked: Claude rewrites it on exit, and two writers would clobber each other.
if [ -f "$DEV_HOME/.claude.json" ] && [ ! -e "$CLAUDE_OWN/.claude.json" ]; then
  cp -p "$DEV_HOME/.claude.json" "$CLAUDE_OWN/.claude.json"
fi

# The auto-update lock lives in the config folder too, so separate folders no longer stop two
# containers from installing into the one shared npm prefix at the same moment. One container
# updates; the rest pick the new binary up from that prefix.
CLAUDE_UPDATER="$(container_name "${DEV_CLAUDE_UPDATER:-workspace}")"

# --- create ------------------------------------------------------------------------------
args=(
  --name "$NAME"
  --init                                  # reap zombies; node and git leave them
  --user "$(id -u):$(id -g)"              # files in /workspace stay host-owned
  -e HOME=/dev-home
  -e REPO_ROOT=/workspace
  -e GIT_TERMINAL_PROMPT=0
  -e CLAUDE_CONFIG_DIR="/dev-home/.claude-containers/$NAME"
  # Not a link into the shared folder: Claude refuses to open a symlinked .credentials.json.
  -e CLAUDE_SECURESTORAGE_CONFIG_DIR=/dev-home/.claude
  -v "$REPO_ROOT:/workspace"
  -v "$DEV_HOME:/dev-home"
  -w "$WORKDIR"
  -p "$PORT_SPEC"
  --memory "$MEMORY"
  --pids-limit "$PIDS"
  --shm-size "$SHM"
  --security-opt no-new-privileges
)

# Only when the file is non-empty. Docker creates a *directory* at a bind source that does
# not exist, so a failed generation above would mount a directory over /etc/passwd and break
# every lookup in the container rather than just the missing one.
if [ -s "$PASSWD_FILE" ]; then
  args+=( -v "$PASSWD_FILE:/etc/passwd:ro" )
else
  echo "⚠️  no $PASSWD_FILE — ssh in the container will fail with 'No user exists for uid $(id -u)'" >&2
fi

# Only when non-empty: an empty GH_TOKEN is worse than absent, because gh treats it as a
# configured-but-broken credential instead of falling back to a stored login. Never baked
# into a layer — a token in an image layer survives being deleted from it.
if [ -n "${GH_TOKEN:-}" ]; then args+=( -e "GH_TOKEN=${GH_TOKEN}" ); fi

if [ "$NAME" != "$CLAUDE_UPDATER" ]; then args+=( -e DISABLE_AUTOUPDATER=1 ); fi

if [ "$MOUNT_DOCKER_SOCK" = 1 ]; then
  [ -S /var/run/docker.sock ] || { echo "DEV_DOCKER_SOCK=1 but /var/run/docker.sock is not a socket" >&2; exit 1; }
  echo "⚠️  mounting docker.sock — anything in this container has root on the host."
  args+=( -v /var/run/docker.sock:/var/run/docker.sock )
  # The container runs as the host uid, which is not in the socket's group; without this the
  # mount is there but every docker command says "permission denied".
  args+=( --group-add "$(stat -L -c %g /var/run/docker.sock)" )
fi

echo "🚀 launching '${NAME}' at ${WORKDIR}"
echo "   host port: docker port ${NAME} 5000"
# Deliberately NOT --rm: it looks tidy and sets a trap, because typing `exit` would delete
# a container that may be hosting a live agent session, with no way to start it again.
exec docker run -it "${args[@]}" "$IMAGE" bash
